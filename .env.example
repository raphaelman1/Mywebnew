# GEMINI_API_KEY: Required for Gemini AI API calls server-side.
# In AI Studio, inject this via Secrets panel. On Vercel, set in Project Settings > Environment Variables.
GEMINI_API_KEY=""

# APP_URL: The public URL of the application.
APP_URL="https://mywebsite-eo63ya610-ralphdevtz.vercel.app"

# SUPABASE INTEGRATION (Client-side variables prefixed with VITE_)
# Required for real email authentication, email verification, and RLS PostgreSQL database.
# Find these in your Supabase Project Dashboard -> Settings -> API.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# OPTIONAL SERVER-SIDE SUPABASE SERVICE KEY (For backend operations)
SUPABASE_SERVICE_ROLE_KEY=""
